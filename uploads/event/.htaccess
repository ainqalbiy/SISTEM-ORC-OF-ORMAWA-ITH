Options -Indexes

# Blokir eksekusi file PHP dan script berbahaya
<FilesMatch "\.(php|php3|php4|php5|phtml|pl|py|jsp|asp|sh|cgi)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Izinkan akses ke file gambar dan dokumen
<FilesMatch "\.(jpg|jpeg|png|gif|webp|pdf|docx|doc|xlsx|xls|pptx|ppt|zip|txt)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>
